    <div class="form-card">
    <div class="field">
      <label>Restrições ou preferências (opcional)</label>
      <input type="text" id="ia-restricao" placeholder="Ex: vegetariano, sem lactose, sem glúten...">
    </div>
    </div>

    <button class="btn secondary" onclick="gerarSugestaoIA()">Gerar sugestão do dia</button>
    <p class="loading" id="ia-loading">Gerando sugestão...</p>
