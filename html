<script>
/* ============================================================
   Data / estado
   ============================================================ */
document.getElementById('today').textContent = new Date().toLocaleDateString('pt-BR', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();

/* barcode decorativo — larguras pseudo-aleatórias fixas para um padrão consistente */
(function gerarBarcode(){
  const larguras = [2,4,2,6,2,2,8,2,4,2,2,6,4,2,8,2,2,4,2,6,2,8,2,4,2,2,6,2,4,8,2,2,4,2,6,2,2,8,4,2];
  const el = document.getElementById('barcode');
  el.innerHTML = larguras.map(w => `<span style="width:${w}px; height:${18 + (w%3)*6}px;"></span>`).join('');
})();

let ultimoCalculo = null; // guarda o resultado mais recente da calculadora, usado no histórico e na IA

/* ============================================================
   Tabs
   ============================================================ */
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(btn.dataset.tab).classList.add('active');
  });
});

/* ============================================================
   Calculadora de calorias (Mifflin-St Jeor)
   ============================================================ */
function calcularCalorias(){
  const idade = parseFloat(document.getElementById('c-idade').value);
  const sexo = document.getElementById('c-sexo').value;
  const peso = parseFloat(document.getElementById('c-peso').value);
  const altura = parseFloat(document.getElementById('c-altura').value);
  const atividade = parseFloat(document.getElementById('c-atividade').value);
  const objetivo = document.getElementById('c-objetivo').value;

  if(!idade || !peso || !altura){
    alert('Preencha idade, peso e altura.');
    return;
  }

  let tmb = sexo === 'M'
    ? (10*peso + 6.25*altura - 5*idade + 5)
    : (10*peso + 6.25*altura - 5*idade - 161);

  let tdee = tmb * atividade;

  let meta = tdee;
  if(objetivo === 'perder') meta = tdee - 500;
  if(objetivo === 'ganhar') meta = tdee + 500;

  const proteina = Math.round(peso * 1.8); // g/dia, faixa ativa
  const agua = (peso * 35 / 1000).toFixed(1); // litros/dia

  document.getElementById('r-tmb').textContent = Math.round(tmb) + ' kcal';
  document.getElementById('r-tdee').textContent = Math.round(tdee) + ' kcal';
  document.getElementById('r-meta').textContent = Math.round(meta) + ' kcal';
  document.getElementById('r-prot').textContent = proteina + ' g';
  document.getElementById('r-agua').textContent = agua + ' L';

  let nota = '';
  if(idade < 18){
    nota = 'Menor de 18 anos: essa fórmula foi validada para adultos. Em crianças e adolescentes, use como referência aproximada e priorize acompanhamento com pediatra/nutricionista.';
  } else if(idade >= 60){
    nota = 'A partir dos 60 anos, a necessidade de proteína tende a ser um pouco maior por grama de peso corporal para preservar massa muscular.';
  } else {
    nota = 'Estimativa baseada na fórmula de Mifflin-St Jeor, considerada uma das mais precisas para adultos.';
  }
  document.getElementById('r-nota').textContent = nota;
  document.getElementById('resultado-card').classList.add('show');

  ultimoCalculo = { idade, sexo, peso, altura, objetivo, tmb: Math.round(tmb), tdee: Math.round(tdee), meta: Math.round(meta), proteina, agua };
}

/* ============================================================
   Combinação alimentar — dados
   ============================================================ */
const combinacoes = [
  { tipo:'good', texto:'Vegetais folhosos (alface, rúcula, couve) combinam bem com qualquer proteína ou carboidrato — são neutros e favorecem a digestão.' },
  { tipo:'good', texto:'Proteína magra (frango, peixe, ovo) + vegetais coloridos: combinação leve, boa absorção de nutrientes.' },
  { tipo:'good', texto:'Carboidrato complexo (arroz integral, batata-doce) + leguminosas (feijão, lentilha): juntos formam proteína completa.' },
  { tipo:'good', texto:'Frutas ácidas (laranja, abacaxi, limão) ajudam a absorção de ferro quando consumidas perto de refeições com feijão ou carnes.' },
  { tipo:'bad', texto:'Frutas doces (banana, manga) logo após refeições pesadas podem fermentar mais facilmente no estômago — prefira consumir frutas isoladamente, 20–30 min antes das refeições.' },
  { tipo:'bad', texto:'Leite integral junto de refeições salgadas e gordurosas pode deixar a digestão mais lenta em pessoas sensíveis.' },
  { tipo:'bad', texto:'Excesso de carboidrato refinado + proteína animal em grande quantidade na mesma refeição sobrecarrega a digestão — prefira moderar as porções.' },
  { tipo:'good', texto:'Gorduras boas (azeite, abacate, castanhas) ajudam a absorver vitaminas lipossolúveis (A, D, E, K) presentes nos vegetais.' },
];

function renderCombinacoes(){
  const el = document.getElementById('combo-list');
  el.innerHTML = combinacoes.map(c => `
    <div class="combo-row">
      <span class="combo-tag ${c.tipo}">${c.tipo === 'good' ? 'BOA' : 'EVITAR'}</span>
      <span class="combo-text">${c.texto}</span>
    </div>
  `).join('');
}
renderCombinacoes();

/* ============================================================
   Sugestões por idade — dados
   ============================================================ */
const faixas = [
  {
    classe:'', nome:'Crianças', range:'2 a 12 anos',
    foco:['Cálcio e vitamina D para ossos (leite, iogurte, queijo)','Ferro para desenvolvimento cognitivo (feijão, carnes magras, folhas verde-escuras)','Frutas variadas todos os dias (banana, mamão, maçã)','Proteína de qualidade em porções pequenas e frequentes (ovo, frango desfiado, peixe)'],
    evitar:'Evitar excesso de açúcar, refrigerantes e ultraprocessados — priorizar comida de verdade em porções adequadas à idade.'
  },
  {
    classe:'teen', nome:'Adolescentes', range:'13 a 17 anos',
    foco:['Maior demanda calórica e proteica pelo crescimento acelerado','Cálcio e ferro em dobro (leite e derivados, carnes, leguminosas)','Carboidratos complexos para energia sustentada (arroz integral, aveia, batata-doce)','Ômega-3 para desenvolvimento cerebral (peixes, chia, linhaça)'],
    evitar:'Evitar dietas restritivas sem acompanhamento profissional — essa é uma fase crítica de crescimento.'
  },
  {
    classe:'adult', nome:'Adultos', range:'18 a 59 anos',
    foco:['Equilíbrio entre proteínas, carboidratos e gorduras boas','Fibras para saúde intestinal (vegetais, grãos integrais, frutas com casca)','Proteína magra distribuída ao longo do dia (peixe, frango, ovos, leguminosas)','Gorduras boas com moderação (azeite, abacate, oleaginosas)'],
    evitar:'Reduzir sódio, açúcar e ultraprocessados; manter boa hidratação diária.'
  },
  {
    classe:'senior', nome:'Idosos', range:'60 anos ou mais',
    foco:['Proteína de fácil digestão para preservar massa muscular (ovo, peixe, frango, iogurte)','Cálcio e vitamina D reforçados para saúde óssea','Fibras e boa hidratação para função intestinal','Alimentos macios e bem cozidos quando houver dificuldade de mastigação'],
    evitar:'Atenção ao excesso de sódio (pressão arterial) e a interações entre alimentos e medicamentos — consultar nutricionista é recomendado.'
  },
];

function renderFaixas(){
  const el = document.getElementById('idades-list');
  el.innerHTML = faixas.map((f,i) => `
    <div class="age-card ${f.classe}">
      <span class="idx">${String(i+1).padStart(2,'0')}</span>
      <h3>${f.nome}</h3>
      <span class="range">${f.range}</span>
      <ul>${f.foco.map(i=>`<li>${i}</li>`).join('')}</ul>
      <p class="avoid">${f.evitar}</p>
    </div>
  `).join('');
}
renderFaixas();

/* ============================================================
   Supabase — histórico
   ============================================================ */
let supabase = null;
if(CONFIG.ENABLE_HISTORICO && window.supabase){
  supabase = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_ANON_KEY);
}

async function entrarOuCadastrar(){
  if(!supabase){ document.getElementById('auth-status').textContent = 'Supabase não configurado no CONFIG.'; return; }
  const email = document.getElementById('h-email').value;
  const senha = document.getElementById('h-senha').value;
  if(!email || !senha){ document.getElementById('auth-status').textContent = 'Preencha e-mail e senha.'; return; }

  document.getElementById('auth-status').textContent = 'Entrando...';
  let { data, error } = await supabase.auth.signInWithPassword({ email, password: senha });

  if(error){
    // tenta cadastrar se não existir ainda
    const cad = await supabase.auth.signUp({ email, password: senha });
    if(cad.error){ document.getElementById('auth-status').textContent = 'Erro: ' + cad.error.message; return; }
    document.getElementById('auth-status').textContent = 'Conta criada! Verifique seu e-mail se a confirmação estiver ativada.';
  } else {
    document.getElementById('auth-status').textContent = 'Login realizado.';
    document.getElementById('auth-box').style.display = 'none';
    document.getElementById('hist-area').style.display = 'block';
    carregarHistorico();
  }
}

async function sair(){
  if(supabase) await supabase.auth.signOut();
  document.getElementById('auth-box').style.display = 'block';
  document.getElementById('hist-area').style.display = 'none';
}

async function salvarHistorico(){
  if(!supabase){ alert('Supabase não configurado.'); return; }
  if(!ultimoCalculo){ alert('Calcule suas calorias na aba Calculadora primeiro.'); return; }
  const { data: userData } = await supabase.auth.getUser();
  if(!userData.user){ alert('Faça login primeiro.'); return; }

  const { error } = await supabase.from('historico').insert({
    user_id: userData.user.id,
    peso: ultimoCalculo.peso,
    tdee: ultimoCalculo.tdee,
    meta: ultimoCalculo.meta,
    objetivo: ultimoCalculo.objetivo,
  });
  if(error){ alert('Erro ao salvar: ' + error.message); return; }
  carregarHistorico();
}

async function carregarHistorico(){
  if(!supabase) return;
  const { data: userData } = await supabase.auth.getUser();
  if(!userData.user) return;
  const { data, error } = await supabase
    .from('historico')
    .select('*')
    .eq('user_id', userData.user.id)
    .order('created_at', { ascending:false })
    .limit(20);
  if(error) return;
  document.getElementById('hist-list').innerHTML = data.map(r => `
    <div class="hist-row">
      <span class="d">${new Date(r.created_at).toLocaleDateString('pt-BR')}</span>
      <span>Peso: ${r.peso}kg · Meta: ${r.meta}kcal · ${r.objetivo}</span>
    </div>
  `).join('') || '<p class="status-msg">Nenhum registro ainda.</p>';
}

/* ============================================================
   Foto do prato — estimativa de calorias via IA (visão)
   Chama nossa própria function (/api/analisar-foto), que guarda
   a chave da Anthropic em segurança no servidor da Vercel.
   ============================================================ */
let fotoBase64 = null;
let fotoMediaType = null;

function preverFoto(){
  const input = document.getElementById('f-input');
  const file = input.files[0];
  if(!file) return;

  fotoMediaType = file.type;
  const reader = new FileReader();
  reader.onload = () => {
    fotoBase64 = reader.result.split(',')[1];
    const preview = document.getElementById('f-preview');
    preview.src = reader.result;
    preview.style.display = 'block';
    document.getElementById('f-btn').disabled = false;
    document.getElementById('f-resultado').classList.remove('show');
  };
  reader.readAsDataURL(file);
}

async function analisarFoto(){
  if(!fotoBase64){ alert('Escolha uma foto primeiro.'); return; }

  const loadingEl = document.getElementById('f-loading');
  const resultCard = document.getElementById('f-resultado');
  const conteudo = document.getElementById('f-conteudo');

  loadingEl.classList.add('show');
  resultCard.classList.remove('show');

  try{
    const response = await fetch("/api/analisar-foto", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ imageBase64: fotoBase64, mediaType: fotoMediaType })
    });
    const data = await response.json();
    conteudo.textContent = data.texto || data.error || 'Não foi possível analisar a foto.';
    resultCard.classList.add('show');
  }catch(e){
    conteudo.textContent = 'Erro ao analisar a foto: ' + e.message;
    resultCard.classList.add('show');
  }finally{
    loadingEl.classList.remove('show');
  }
}

/* ============================================================
   Sugestão via IA
   Chama nossa própria function (/api/sugestao-ia), que guarda
   a chave da Anthropic em segurança no servidor da Vercel.
   ============================================================ */
async function gerarSugestaoIA(){
  const restricao = document.getElementById('ia-restricao').value;
  const resultEl = document.getElementById('ia-result');
  const loadingEl = document.getElementById('ia-loading');

  if(!ultimoCalculo){
    alert('Calcule suas calorias na aba Calculadora primeiro.');
    return;
  }

  loadingEl.classList.add('show');
  resultEl.classList.remove('show');

  const prompt = `Monte um cardápio de um dia (café da manhã, almoço, lanche, jantar) para uma pessoa de ${ultimoCalculo.idade} anos, objetivo de ${ultimoCalculo.objetivo} peso, meta de aproximadamente ${ultimoCalculo.meta} kcal/dia e ${ultimoCalculo.proteina}g de proteína/dia. ${restricao ? 'Restrições/preferências: ' + restricao + '.' : ''} Use alimentos comuns no Brasil. Responda em português, de forma direta e organizada por refeição, sem introdução.`;

  try{
    const response = await fetch("/api/sugestao-ia", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ prompt })
    });
    const data = await response.json();
    resultEl.textContent = data.texto || data.error || 'Não foi possível gerar a sugestão.';
    resultEl.classList.add('show');
  }catch(e){
    resultEl.textContent = 'Erro ao gerar sugestão: ' + e.message;
    resultEl.classList.add('show');
  }finally{
    loadingEl.classList.remove('show');
  }
}
</script>

